	<MeshDomains>
		<SolidDomain name="Part1" mat="Material1"/>
	</MeshDomains>
	<Initial>
		<ic name="IC1" type="initial velocity">
			<vx type="math">-pi / 4 * (exp(pi * X / 4) * sin(pi * (Y + 2 * Z) / 4) + exp(pi * Z / 4) * cos(pi * (X + 2 * Y) / 4))</vx>
			<vy type="math">-pi / 4 * (exp(pi * Y / 4) * sin(pi * (2 * X + Z) / 4) + exp(pi * X / 4) * cos(pi * (Y + 2 * Z) / 4))</vy>
			<vz type="math">-pi / 4 * (exp(pi * Z / 4) * sin(pi * (X + 2 * Y) / 4) + exp(pi * Y / 4) * cos(pi * (2 * X + Z) / 4))</vz>
		</ic>
		<ic name="IC2" type="initial pressure">
			<pressure type="math">
				fluid_density = 1;
				time_part = -fluid_density*pi*pi/32;
				space_part = exp(pi * X / 2) + exp(pi * Y / 2) + exp(pi * Z / 2)
					+ 2 * exp(pi * (X + Y) / 4) * cos(pi * (Y + 2 * Z) / 4) * sin(pi * (Z + 2 * X) / 4)
					+ 2 * exp(pi * (X + Z) / 4) * cos(pi * (X + 2 * Y) / 4) * sin(pi * (Y + 2 * Z) / 4)
					+ 2 * exp(pi * (Y + Z) / 4) * cos(pi * (Z + 2 * X) / 4) * sin(pi * (X + 2 * Y) / 4);
				time_part * space_part
			</pressure>
		</ic>
	</Initial>
	<Boundary>
		<bc name="BC1" type="prescribed velocity" surface="VelocitySurface">
			<!-- had to substitute kinvis = 10 since parameters can't be nested! -->
			<!-- There is a bug in the parameter substitution: using a variable c (instead of d) will replace the first 'c' in cos as well. -->
			<vx type="math">
				d = pi * exp(-pi* pi* 10 * t / 4);
				-1 * d / 4 * (exp(pi * X / 4) * sin(pi * (Y + 2*Z) / 4) + exp(pi* Z / 4) * cos(pi* (X + 2*Y) / 4))
			</vx>
			<vy type="math">
				d = pi * exp(-pi* pi* 10 * t / 4);
				-1 * d / 4 * (exp(pi *Y / 4) * sin(pi * (2 * X + Z) / 4) + exp(pi * X / 4) * cos(pi * (Y + 2 * Z) / 4))
			</vy>
			<vz type="math">
				d = pi * exp(-pi* pi* 10 * t / 4);
				-1 * d / 4 * (exp(pi* Z / 4) * sin(pi* (X + 2 * Y) / 4) + exp(pi * Y / 4) * cos(pi * (2 * X + Z) / 4))
			</vz>
		</bc>
	</Boundary>
	<Loads>
		<surface_load name="LOAD1" type="traction" surface="LoadSurface">
			<tx type="math">
				dyn_viscosity = 10;
				kinvis = 10;
				pressure = (-1*pi*pi/32*exp(-pi*pi*t*10/2)) * (exp(pi*X/2)+exp(pi*Y/2)+exp(pi*Z/2)
					+ 2*exp(pi*(X + Y)/4)*cos(pi*(Y + 2*Z)/4)*sin(pi*(2*X + Z)/4)
					+ 2*exp(pi*(X + Z)/4)*cos(pi*(X + 2*Y)/4)*sin(pi*(Y + 2*Z)/4)
					+ 2*exp(pi*(Y + Z)/4)*cos(pi*(2*X + Z)/4)*sin(pi*(X + 2*Y)/4));
				pressure + (pi*pi*dyn_viscosity*exp(-(pi*pi*kinvis*t)/4)*(exp((pi*X)/4)*sin((pi*(Y+2*Z))/4)-exp((pi*Z)/4)*sin((pi*(X+2*Y))/4)))/8</tx>
			<ty type="math">
				dyn_viscosity = 10;
				kinvis = 10;
				2*dyn_viscosity*((pi*exp(-(pi*pi*kinvis*t)/4)*((pi*exp((pi*X)/4)*cos((pi*(Y+2*Z))/4))/4+(pi*exp((pi*Y)/4)*cos((pi*(2*X+Z))/4))/2))/8-(pi*exp(-(pi*pi*kinvis*t)/4)*((pi*exp((pi*Z)/4)*sin((pi*(X+2*Y))/4))/2-(pi*exp((pi*X)/4)*cos((pi*(Y+2*Z))/4))/4))/8)</ty>
			<tz type="math">
				dyn_viscosity = 10;
				kinvis = 10;
				2*dyn_viscosity*((pi*exp(-(pi*pi*kinvis*t)/4)*((pi*exp((pi*X)/4)*cos((pi*(Y+2*Z))/4))/2+(pi*exp((pi*Z)/4)*cos((pi*(X+2*Y))/4))/4))/8-(pi*exp(-(pi*pi*kinvis*t)/4)*((pi*exp((pi*Y)/4)*sin((pi*(2*X+Z))/4))/2-(pi*exp((pi*Z)/4)*cos((pi*(X+2*Y))/4))/4))/8)</tz>
		</surface_load>
	</Loads>
	<Output>
		<plotfile type="febio">
			<var type="mfem pressure"/>
			<var type="mfem velocity"/>
		</plotfile>
	</Output>
</febio_spec>
