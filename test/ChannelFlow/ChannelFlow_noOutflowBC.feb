<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="4.0">
	<Module type="mfemifsi"/>
	<Control>
		<analysis>0</analysis>
		<time_steps>200</time_steps>
		<step_size>0.01</step_size>
		<plot_zero_state>0</plot_zero_state>
		<plot_range>0,-1</plot_range>
		<plot_level>PLOT_MAJOR_ITRS</plot_level>
		<output_level>OUTPUT_MAJOR_ITRS</output_level>
		<plot_stride>1</plot_stride>
		<output_stride>1</output_stride>
		<adaptor_re_solve>1</adaptor_re_solve>
		<time_stepper type="default">
			<max_retries>5</max_retries>
			<opt_iter>11</opt_iter>
			<dtmin>0</dtmin>
			<dtmax>0.1</dtmax>
			<aggressiveness>0</aggressiveness>
			<cutback>0.5</cutback>
			<dtforce>0</dtforce>
		</time_stepper>
		<solver type="mfem">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<equation_scheme>staggered</equation_scheme>
			<equation_order>default</equation_order>
			<optimize_bw>0</optimize_bw>
			<velocity_order>1</velocity_order>
			<pressure_order>1</pressure_order>
			<VMS>1</VMS>
			<Laplace_form>1</Laplace_form>
			<Zero_mean_pressure>0</Zero_mean_pressure>
			<pre_partition_mesh>0</pre_partition_mesh>
			<pre_partition_opt>PartitionMesh</pre_partition_opt>
			<pre_partition_num_ranks>1</pre_partition_num_ranks>
			<Immersed_solid>0</Immersed_solid>
			<Solid_solver_type>FEBio</Solid_solver_type>
			<Subtract_viscous_stress>1</Subtract_viscous_stress>
			<Three_field_formulation>0</Three_field_formulation>
			<VMS_stabilization_scaling>1</VMS_stabilization_scaling>
			<Track_node>0</Track_node>
			<Track_node_position>0,0,0</Track_node_position>
			<Output_avg_velocity>0</Output_avg_velocity>
			<Stress_measure_nodal_outputs></Stress_measure_nodal_outputs>
			<Strain_measure_nodal_outputs></Strain_measure_nodal_outputs>
			<time_stepping_method>GenAlpha</time_stepping_method>
			<rho_inf>0.5</rho_inf>
			<step_save>1</step_save>
			<steady_state_save>0</steady_state_save>
			<steady_state_step_save>1</steady_state_step_save>
			<steady_state_time>0</steady_state_time>
			<write_restart_files>0</write_restart_files>
			<restart_step_save>1</restart_step_save>
			<restart_simulation>0</restart_simulation>
			<restart_step>1</restart_step>
			<write_final_state_as_IC>0</write_final_state_as_IC>
			<final_state_folder>InitialConditions</final_state_folder>
			<start_from_specific_time>0</start_from_specific_time>
			<start_sim_time>0</start_sim_time>
			<start_sim_step>0</start_sim_step>
			<Save_Wall_Shear_Stress>0</Save_Wall_Shear_Stress>
			<Save_Vorticity>0</Save_Vorticity>
			<Save_Q_Criterion>0</Save_Q_Criterion>
			<Output_surface_pressures>0</Output_surface_pressures>
			<Output_surface_flow_rates>0</Output_surface_flow_rates>
			<no_error_nonconvergence>0</no_error_nonconvergence>
			<atol>1e-06</atol>
			<rtol>0.001</rtol>
			<minIt>3</minIt>
			<maxIt>10</maxIt>
			<solver_type>FGMRES</solver_type>
			<lin_atol>1e-06</lin_atol>
			<lin_rtol>0.001</lin_rtol>
			<lin_maxIt>200</lin_maxIt>
			<prec_type>SIMPLE</prec_type>
			<inner_solver_type>Iterative</inner_solver_type>
			<Ainv_atol>1e-06</Ainv_atol>
			<Ainv_rtol>0.001</Ainv_rtol>
			<Sinv_atol>1e-06</Sinv_atol>
			<Sinv_rtol>0.001</Sinv_rtol>
		</solver>
	</Control>
