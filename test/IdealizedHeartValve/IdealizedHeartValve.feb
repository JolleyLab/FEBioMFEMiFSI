			<quad4 id="32">609,1,5,610</quad4>
		</Surface>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Part1" mat="Material1"/>
		<SolidDomain name="Part3" mat="Material2"/>
		<SolidDomain name="Part4" mat="Material2"/>
	</MeshDomains>
	<Boundary>
		<bc name="NoSlip1" surface="NoSlip1" type="no slip"/>
		<bc name="PrescribedVelocityComponent2" surface="PrescribedVelocityComponent2" type="prescribed velocity component">
			<dof>vz</dof>
			<value>0</value>
		</bc>
		<bc name="PrescribedVelocity3" surface="PrescribedVelocity3" type="prescribed velocity">
			<vx type="math">5*(sin(2*pi*t) + 1.1) * Y * (1.61 - Y)</vx>
			<vy>0</vy>
			<vz>0</vz>
		</bc>
	</Boundary>
	<Output>
		<plotfile type="febio">
			<var type="mfem pressure"/>
			<var type="mfem velocity"/>
			<var type="mfem immersed displacement"/>
			<var type="mfem immersed velocity"/>
		</plotfile>
	</Output>
</febio_spec>
