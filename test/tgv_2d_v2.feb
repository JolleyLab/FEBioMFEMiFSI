<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="4.0">
	<Module type="solid">
		<units>SI</units>
	</Module>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<plot_zero_state>0</plot_zero_state>
		<plot_range>0,-1</plot_range>
		<plot_level>PLOT_MAJOR_ITRS</plot_level>
		<output_level>OUTPUT_MAJOR_ITRS</output_level>
		<plot_stride>1</plot_stride>
		<output_stride>1</output_stride>
		<adaptor_re_solve>1</adaptor_re_solve>
		<time_stepper type="default">
			<max_retries>5</max_retries>
			<opt_iter>11</opt_iter>
			<dtmin>0</dtmin>
			<dtmax>0.1</dtmax>
			<aggressiveness>0</aggressiveness>
			<cutback>0.5</cutback>
			<dtforce>0</dtforce>
		</time_stepper>
		<solver type="solid">
			<symmetric_stiffness>preferred</symmetric_stiffness>
			<equation_scheme>staggered</equation_scheme>
			<equation_order>default</equation_order>
			<optimize_bw>0</optimize_bw>
			<lstol>0.9</lstol>
			<lsmin>0.01</lsmin>
			<lsiter>5</lsiter>
			<ls_check_jacobians>0</ls_check_jacobians>
			<max_refs>15</max_refs>
			<check_zero_diagonal>0</check_zero_diagonal>
			<zero_diagonal_tol>0</zero_diagonal_tol>
			<force_partition>0</force_partition>
			<reform_each_time_step>1</reform_each_time_step>
			<reform_augment>0</reform_augment>
			<diverge_reform>1</diverge_reform>
			<min_residual>1e-20</min_residual>
			<max_residual>0</max_residual>
			<dtol>0.001</dtol>
			<etol>0.01</etol>
			<rtol>0</rtol>
			<rhoi>-2</rhoi>
			<alpha>1</alpha>
			<beta>0.25</beta>
			<gamma>0.5</gamma>
			<logSolve>0</logSolve>
			<arc_length>0</arc_length>
			<arc_length_scale>0</arc_length_scale>
			<qn_method type="BFGS">
				<max_ups>10</max_ups>
				<max_buffer_size>0</max_buffer_size>
				<cycle_buffer>1</cycle_buffer>
				<cmax>100000</cmax>
			</qn_method>
		</solver>
	</Control>
	<Globals>
		<Constants>
			<T>0</T>
			<P>0</P>
			<R>8.31446</R>
			<Fc>96485.3</Fc>
		</Constants>
	</Globals>
	<Material>
		<material id="1" name="Material2" type="neo-Hookean">
			<density>1</density>
			<E>1</E>
			<v>0.3</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="tgv_2d_v2">
			<node id="1">-0.5,-0.5,0</node>
			<node id="2">-0.5,0,0</node>
			<node id="3">-0.5,0.5,0</node>
			<node id="4">0,-0.5,0</node>
			<node id="5">0.5,-0.5,0</node>
			<node id="6">0.5,0,0</node>
			<node id="7">0.5,0.5,0</node>
			<node id="8">0,0.5,0</node>
			<node id="9">0,0,0</node>
		</Nodes>
		<Elements type="quad4" name="Part1">
			<elem id="1">2,3,8,9</elem>
		</Elements>
		<Elements type="quad4" name="Part2">
			<elem id="2">8,7,6,9</elem>
		</Elements>
		<Elements type="quad4" name="Part3">
			<elem id="3">6,5,4,9</elem>
		</Elements>
		<Elements type="quad4" name="Part4">
			<elem id="4">1,2,9,4</elem>
		</Elements>
		<Edge name="edge1">
			<line2 id="1">3,8</line2>
			<line2 id="2">7,6</line2>
			<line2 id="3">5,4</line2>
			<line2 id="4">1,2</line2>
		</Edge>
		<Edge name="edge2">
			<line2 id="1">2,3</line2>
			<line2 id="2">8,7</line2>
			<line2 id="3">6,5</line2>
			<line2 id="4">4,1</line2>
		</Edge>
	</Mesh>
	<MeshDomains>
		<ShellDomain name="Part1" mat="Material2">
			<shell_thickness>0.1</shell_thickness>
		</ShellDomain>
		<ShellDomain name="Part2" mat="Material2">
			<shell_thickness>0.1</shell_thickness>
		</ShellDomain>
		<ShellDomain name="Part3" mat="Material2">
			<shell_thickness>0.1</shell_thickness>
		</ShellDomain>
		<ShellDomain name="Part4" mat="Material2">
			<shell_thickness>0.1</shell_thickness>
		</ShellDomain>
	</MeshDomains>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="relative volume"/>
		</plotfile>
	</Output>
</febio_spec>
